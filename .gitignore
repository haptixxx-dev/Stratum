# ═══════════════════════════════════════════════════════════════════
# Build
# ═══════════════════════════════════════════════════════════════════
build/
cmake-build-*/
out/

# ═══════════════════════════════════════════════════════════════════
# IDE / Editor
# ═══════════════════════════════════════════════════════════════════
.idea/
.vscode/
*.swp
*.swo
*~
.cache/
compile_commands.json

# ═══════════════════════════════════════════════════════════════════
# OS
# ═══════════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db

# ═══════════════════════════════════════════════════════════════════
# Project specific
# ═══════════════════════════════════════════════════════════════════
*.osm
*.pbf
# ...except the hand-authored test fixtures, which ARE source. Without this
# negation the golden-file suites cannot run on a fresh clone: the .osm files
# they parse are excluded by the rule above, which is meant for downloaded
# extracts sitting in the working tree.
!tests/data/*.osm
data/cache/
data/exports/

# ═══════════════════════════════════════════════════════════════════
# Documentation
# ═══════════════════════════════════════════════════════════════════
docs/generated/

# Keep compile_commands for clangd
!build/compile_commands.json
imgui.ini
renderdoc/

# Parallel-agent git worktrees (see launch-features.sh)
Worktrees/

# ═══════════════════════════════════════════════════════════════════
# Exported meshes (road_export / OBJ dumps) — can reach tens of GB
# ═══════════════════════════════════════════════════════════════════
TestOutput/
road_export/
road_dump/
