// A street of buildings that differ, and differ the SAME WAY every time.
//
// This is the example about determinism, which is the property that makes a
// procedural city usable rather than a novelty. Run it twice with the same
// seed and you get the same street, vertex for vertex. Change the seed and you
// get a different street. Add a plot at one end and the others do NOT
// reshuffle, because a shape draws from its own ADDRESS in the tree and never
// from a shared stream of random numbers.
//
// That last property is the one that costs money to get wrong. With a shared
// stream, inserting a building at the start of the row changes every building
// after it, and a bug someone reported yesterday stops reproducing.
//
// Measured on a 60 x 14 seed: seed 0 gives 225 terminals and 2316 triangles,
// twice, with a byte-identical dump. Seed 7 gives 263 terminals and 2852
// triangles. Same file, same machine, different street.
//
// Seed: a long strip, about 60 x 14 m.

attr storey : float = 3.0

@start
rule Street {
    split(x) { repeat { 8.0 : { Plot(); } } }
}

// Three shapes of building, weighted. `choose` normalises by the sum, so
// 3/2/1 means half, a third and a sixth.
rule Plot {
    choose {
        3 : { Block(3.0, "gable"); }
        2 : { Block(4.0, "hip"); }
        1 : { Block(6.0, "shed"); }
    }
}

// random.range() draws a depth between the two bounds, again from the shape's
// own address. Two buildings on the same street get different depths; the same
// building gets the same depth on every run.
rule Block(levels: float, roof_kind: string) {
    split(z) {
        random.range(8.0, 11.0) : { Mass(levels, roof_kind); }
        ~1.0                    : { Yard(); }
    }
}

rule Mass(levels: float, roof_kind: string) {
    floors(levels, storey);
    select face {
        front : { Elevation(levels); }
        side  : { Party(); }
        back  : { Party(); }
        top   : { Cap(roof_kind); }
    }
}

// The roof kind arrived as a STRING parameter and goes straight into roof().
// Five fixed operation names could not express this; one operation taking the
// kind as data can.
rule Cap(roof_kind: string) {
    align_scope("y_up");
    roof(roof_kind, 38.0, 0.3);
}

rule Elevation(levels: float) {
    split(y) {
        storey : { Ground(); }
        repeat { storey : { Upper(); } }
    }
}

// One in four ground floors is a shop rather than a front door.
rule Ground {
    if (random.chance(0.25)) {
        Shopfront();
    } else {
        Doorway();
    }
}

rule Shopfront {
    split(x) { 0.3 : { Pier(); } repeat { 1.8 : { Glass(); } } 0.3 : { Pier(); } }
}

rule Doorway {
    split(x) { ~1.0 : { Render(); } 1.0 : { Door(); } 0.4 : { Render(); }
               1.3 : { Sash(); } ~1.0 : { Render(); } }
}

rule Upper {
    split(x) { repeat { 2.4 : { UpperBay(); } } }
}

rule UpperBay {
    split(x) { ~1.0 : { Render(); } 1.2 : { Sash(); } ~1.0 : { Render(); } }
}

rule Sash   { window(0.0, 0.14, 0.05, 0.06); }
rule Glass  { window(0.0, 0.16, 0.04, 0.02); }
rule Door   { door(0.0, 0.14, 0.05, 0.04); }
rule Render { wall_panel(); }
rule Party  { wall_panel(); }
rule Pier   { wall_panel(0.0, 0.2); }
rule Yard   {}
